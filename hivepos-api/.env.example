# hivePOS API — Go backend environment variables
# Copy to .env and adjust.

# Server
PORT=8080
APP_ENV=development

# Database (same PostgreSQL as the Next.js app during transition)
DATABASE_URL=postgresql://posadmin:poslocal@localhost:5437/pos_saas?sslmode=disable

# JWT (must match the Next.js JWT_SECRET for cross-app token validation)
JWT_SECRET=dev-secret-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# Redis (optional — for session store + future job queue)
REDIS_URL=

# Frontend origin — post-Google-OAuth redirect target. Dev: http://localhost:3008
FE_ORIGIN=http://localhost:3008

# WhatsApp gateway (Baileys microservice). Default points at the local sidecar.
WHATSAPP_GATEWAY_URL=http://localhost:3001

# AI assistant (super-admin) — OpenAI-compatible. Empty AI_API_KEY → assistant disabled.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Self-healing: ErrorLog spike alerting. Empty ALERT_WEBHOOK_URL → alerts skip the network
# call (tickets still open). Thresholds are min-errors-per-fingerprint / scan / lookback.
ALERT_WEBHOOK_URL=
ALERT_ERROR_THRESHOLD=10
ALERT_INTERVAL_MINUTES=5
ALERT_WINDOW_MINUTES=10
