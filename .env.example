# ─── hivepos-web env ───────────────────────────────────────────────
# Copy to `.env` and adjust. All optional — defaults work behind Caddy.

# Browser-side API base. Default "/api" assumes the Caddy edge routes
# /api/* → hivepos-api (same origin, cookies just work).
# Point elsewhere during local dev (no Caddy) or to hit the legacy
# pos-saas backend during the migration transition.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-side (SSR) API origin — MUST be absolute (relative fetch has no base on the server).
# Dev (direct to Go): http://localhost:8080/api. Prod (compose): http://api:8080/api.
API_BASE_URL_SSR=http://localhost:8080/api

# Auth cookie name the backend writes the JWT into (same-origin).
AUTH_COOKIE_NAME=hivepos_token

# Midtrans (Snap.js) — public client key + env. Mirror MIDTRANS_CLIENT_KEY/MIDTRANS_ENV
# from hivepos-api .env. Empty → checkout page hides the Snap flow.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# Show the "Sign in with Google" button (the OAuth flow is handled by hivepos-api
# GET /api/auth/google). Set to "true" when GOOGLE_CLIENT_ID/SECRET are configured.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=
