# deps / build
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/

# local codebase index
**/.codebase-rag/

# tooling artifacts
.playwright-mcp/

# secrets — never commit real env (keep .env.example)
.env
.env.*
!.env.example

# logs / OS
*.log
.DS_Store

# large/unknown local data — review before keeping
/data/

# DB backups (auto-generated by db-backup sidecar; may contain user data)
/backups/

# python bytecode
**/__pycache__/
