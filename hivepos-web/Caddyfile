# Local edge: single origin. /api/* → Go, everything else → Next.
# Prod: replace :80 with your domain (e.g. hivepos.id) for auto-TLS.
# Cloudflare terminates TLS in front — Caddy always sees HTTP, so X-Forwarded-Proto
# comes from Cloudflare (or defaults to https in production).
:80 {
	# brotli first — best ratio for CSS/JS; gzip/zstd fallback. Per the render-blocking
	# CSS goal, brotli shrinks the ~40KiB global stylesheet on the wire vs gzip-only.
	encode zstd br gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
