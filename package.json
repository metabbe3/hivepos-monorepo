{
  "name": "hivepos-web",
  "version": "0.1.0",
  "private": true,
  "description": "hivePOS frontend — Next.js UI consuming the hivepos-api Go backend.",
  "scripts": {
    "dev": "next dev -p 3007",
    "prebuild": "npm run gen:contract && npm run gen:sw-version",
    "build": "next build",
    "start": "next start -p 3007",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:contract": "tsx scripts/gen-contract.ts",
    "gen:sw-version": "node scripts/gen-sw-version.mjs",
    "gen:contract:check": "npm run gen:contract && git diff --exit-code -- lib/api/types.ts docs/contracts",
    "rag:index": "tsx scripts/codebase-rag.ts index",
    "rag:query": "tsx scripts/codebase-rag.ts query",
    "ponytail": "grep -rnE '(#|//) ?ponytail:' . --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=.next --exclude-dir=coverage --exclude-dir=test-results"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-react-parser": "^6.1.4",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.5",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6",
    "js-yaml": "^4.1.0",
    "openapi-typescript": "^7.4.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
